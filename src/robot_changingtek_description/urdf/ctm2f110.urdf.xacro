<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Geometry, joints and inertials come from the ROS 1 CTM2F110 sync model.
       The mount pose is explicitly a project simulation assumption. -->
  <xacro:include filename="$(find robot_changingtek_description)/urdf/upstream/crt_ctm2f110_model_macro.xacro"/>
  <xacro:macro name="ctm2f110_gripper" params="parent prefix mount_xyz:='0 0 0' mount_rpy:='0 0 0'">
    <xacro:crt_ctm_2f_110 prefix="${prefix}"/>
    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
    </joint>
  </xacro:macro>
</robot>
