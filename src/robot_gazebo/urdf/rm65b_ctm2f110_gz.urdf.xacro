<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm65b_ctm2f110_gazebo">
  <xacro:include filename="$(find robot_realman_moveit_config)/urdf/rm65b_ctm2f110.urdf.xacro"/>
  <link name="world"/>
  <joint name="world_to_rm65b" type="fixed"><parent link="world"/><child link="base_link"/></joint>
  <ros2_control name="RM65BCTM2F110GazeboSystem" type="system">
    <hardware><plugin>gz_ros2_control/GazeboSimSystem</plugin></hardware>
    <xacro:macro name="controlled_joint" params="name initial">
      <joint name="${name}">
        <command_interface name="position"/>
        <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:controlled_joint name="joint1" initial="0.0"/>
    <xacro:controlled_joint name="joint2" initial="0.5"/>
    <xacro:controlled_joint name="joint3" initial="-1.0"/>
    <xacro:controlled_joint name="joint4" initial="0.0"/>
    <xacro:controlled_joint name="joint5" initial="0.5"/>
    <xacro:controlled_joint name="joint6" initial="0.0"/>
    <!-- Project simulation pose: partially open and away from either hard stop. -->
    <xacro:controlled_joint name="ctm2f110_finger_joint" initial="0.3"/>
    <!-- Mimic joints have state only; Gazebo applies their URDF mimic relations. -->
    <xacro:macro name="mimic_state" params="name initial">
      <joint name="${name}">
        <state_interface name="position"><param name="initial_value">${initial}</param></state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>
    <xacro:mimic_state name="ctm2f110_rightout_joint" initial="0.3"/>
    <xacro:mimic_state name="ctm2f110_leftinn_joint" initial="-0.3"/>
    <xacro:mimic_state name="ctm2f110_rightinn_joint" initial="-0.3"/>
    <xacro:mimic_state name="ctm2f110_left_kckle_joint" initial="0.3"/>
    <xacro:mimic_state name="ctm2f110_right_kckle_joint" initial="0.3"/>
  </ros2_control>
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robot_gazebo)/config/rm65b_ctm2f110_controllers.yaml</parameters>
      <ros><remapping>/robot_description:=/robot_description_gazebo</remapping></ros>
      <hold_joints>true</hold_joints>
      <position_proportional_gain>0.5</position_proportional_gain>
    </plugin>
  </gazebo>
</robot>
