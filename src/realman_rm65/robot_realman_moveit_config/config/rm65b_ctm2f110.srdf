<?xml version="1.0"?>
<robot name="rm_65_description">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_link"/>
  <group name="rm65_arm"><chain base_link="base_link" tip_link="ctm2f110_tool0"/></group>
  <group name="rm65_hand"><joint name="ctm2f110_finger_joint"/></group>
  <group name="rm65_arm_hand"><group name="rm65_arm"/><group name="rm65_hand"/></group>
  <end_effector name="ctm2f110" parent_link="ctm2f110_tool0" group="rm65_hand" parent_group="rm65_arm"/>
  <group_state name="ready" group="rm65_arm">
    <joint name="joint1" value="0.0"/><joint name="joint2" value="0.5"/>
    <joint name="joint3" value="-1.0"/><joint name="joint4" value="0.0"/>
    <joint name="joint5" value="0.5"/><joint name="joint6" value="0.0"/>
  </group_state>
  <!-- Project simulation presets; q increases the pad separation, as verified from TF. -->
  <group_state name="open" group="rm65_hand"><joint name="ctm2f110_finger_joint" value="0.8"/></group_state>
  <group_state name="closed" group="rm65_hand"><joint name="ctm2f110_finger_joint" value="0.05"/></group_state>
  <disable_collisions link1="base_link" link2="Link1" reason="Adjacent"/>
  <disable_collisions link1="base_link" link2="Link2" reason="Never"/>
  <disable_collisions link1="base_link" link2="Link3" reason="Never"/>
  <disable_collisions link1="Link1" link2="Link2" reason="Adjacent"/>
  <disable_collisions link1="Link1" link2="Link3" reason="Never"/>
  <disable_collisions link1="Link1" link2="Link4" reason="Never"/>
  <disable_collisions link1="Link2" link2="Link3" reason="Adjacent"/>
  <disable_collisions link1="Link2" link2="Link4" reason="Never"/>
  <disable_collisions link1="Link3" link2="Link4" reason="Adjacent"/>
  <disable_collisions link1="Link3" link2="Link5" reason="Never"/>
  <disable_collisions link1="Link3" link2="Link6" reason="Never"/>
  <disable_collisions link1="Link4" link2="Link5" reason="Adjacent"/>
  <disable_collisions link1="Link4" link2="Link6" reason="Never"/>
  <disable_collisions link1="Link5" link2="Link6" reason="Adjacent"/>
  <disable_collisions link1="Link6" link2="ctm2f110_base_link" reason="Adjacent"/>
  <disable_collisions link1="ctm2f110_base_link" link2="ctm2f110_leftout_Link" reason="Adjacent"/>
  <disable_collisions link1="ctm2f110_base_link" link2="ctm2f110_rightout_Link" reason="Adjacent"/>
  <disable_collisions link1="ctm2f110_base_link" link2="ctm2f110_left_kckle" reason="Adjacent"/>
  <disable_collisions link1="ctm2f110_base_link" link2="ctm2f110_right_kckle" reason="Adjacent"/>
  <disable_collisions link1="ctm2f110_leftout_Link" link2="ctm2f110_leftinn_Link" reason="Adjacent"/>
  <disable_collisions link1="ctm2f110_rightout_Link" link2="ctm2f110_rightinn_Link" reason="Adjacent"/>
  <disable_collisions link1="ctm2f110_leftinn_Link" link2="ctm2f110_left_pad" reason="Adjacent"/>
  <disable_collisions link1="ctm2f110_rightinn_Link" link2="ctm2f110_right_pad" reason="Adjacent"/>
  <!-- The source linkage meshes contact at their intended knuckle articulation. -->
  <disable_collisions link1="ctm2f110_left_kckle" link2="ctm2f110_leftinn_Link" reason="Mechanism"/>
  <disable_collisions link1="ctm2f110_right_kckle" link2="ctm2f110_rightinn_Link" reason="Mechanism"/>
  <!-- The two fingertip meshes contact/overlap in the near-closed CAD pose. -->
  <disable_collisions link1="ctm2f110_left_pad" link2="ctm2f110_right_pad" reason="Mechanism"/>
  <disable_collisions link1="ctm2f110_left_pad" link2="ctm2f110_rightinn_Link" reason="Mechanism"/>
  <disable_collisions link1="ctm2f110_leftinn_Link" link2="ctm2f110_right_pad" reason="Mechanism"/>
</robot>
