<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm_65_description">
  <xacro:arg name="wrist_camera" default="true"/>
  <xacro:include filename="$(find rm_description)/urdf/rm_65.urdf.xacro"/>
  <xacro:include filename="$(find robot_changingtek_description)/urdf/ctm2f110.urdf.xacro"/>
  <!-- Identity mount is a simulation placeholder, not a measured RM65B/CTM2F110E adapter. -->
  <xacro:ctm2f110_gripper parent="Link6" prefix="ctm2f110_" mount_xyz="0 0 0" mount_rpy="0 0 0"/>
  <xacro:if value="$(arg wrist_camera)">
    <link name="wrist_camera_link">
      <inertial><mass value="0.03"/><inertia ixx="0.000003" ixy="0" ixz="0" iyy="0.000003" iyz="0" izz="0.000005"/></inertial>
      <!-- Simplified RealSense body: width 100 mm, height 30 mm, thickness 20 mm. -->
      <visual><geometry><box size="0.10 0.02 0.03"/></geometry><material name="camera_black"><color rgba="0.1 0.1 0.1 1"/></material></visual>
      <collision><geometry><box size="0.10 0.02 0.03"/></geometry></collision>
    </link>
    <joint name="wrist_camera_mount" type="fixed">
      <parent link="Link6"/><child link="wrist_camera_link"/>
      <!-- Link6 +Y maps to world +Z in the horizontal-forward observation pose. -->
      <origin xyz="0 0.10 0" rpy="0 0 0"/>
    </joint>
    <link name="camera_color_optical_frame"/>
    <joint name="wrist_camera_optical_joint" type="fixed">
      <parent link="wrist_camera_link"/><child link="camera_color_optical_frame"/>
      <!-- Sensor roll correction plus Gazebo-camera to ROS-optical axes. -->
      <origin xyz="0 0 0" rpy="0 0 3.14159265359"/>
    </joint>
  </xacro:if>
</robot>
