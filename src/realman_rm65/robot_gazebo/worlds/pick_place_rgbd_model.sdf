<?xml version="1.0"?>
<!-- Stage 5 overhead sensor; optical frame is published independently in ROS. -->
<sdf version="1.9">
  <model name="pick_place_rgbd">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="camera_link">
      <inertial><mass>0.1</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/pick_place/rgbd</topic>
        <camera>
          <horizontal_fov>1.20</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.10</near><far>2.0</far></clip>
          <optical_frame_id>camera_color_optical_frame</optical_frame_id>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
