<?xml version="1.0"?>
<!-- Stage 4 contact-only variant; the Stage 1 and fixed-attachment worlds remain unchanged. -->
<sdf version="1.9">
  <world name="empty">
    <physics name="0.5ms" type="ignored">
      <max_step_size>0.0005</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <!-- Loaded without a camera in Stage 4; Stage 5 spawns its own RGB-D model. -->
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pick_table">
      <static>true</static>
      <pose>0.52 0 0.38 0 0 0</pose>
      <link name="top">
        <collision name="collision"><geometry><box><size>0.42 0.60 0.06</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.42 0.60 0.06</size></box></geometry><material><ambient>0.33 0.36 0.38 1</ambient><diffuse>0.42 0.46 0.49 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pick_object">
      <pose>0.43 -0.18 0.52 0 0 0</pose>
      <link name="body">
        <inertial><mass>0.03</mass><inertia><ixx>0.00013325</ixx><iyy>0.00012725</iyy><izz>0.0000185</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.05 0.07 0.22</size></box></geometry>
          <surface><friction><ode><mu>4</mu><mu2>4</mu2></ode><bullet><friction>4</friction><friction2>4</friction2></bullet></friction></surface>
        </collision>
        <sensor name="grasp_contacts" type="contact">
          <always_on>true</always_on>
          <update_rate>100</update_rate>
          <contact><collision>collision</collision></contact>
        </sensor>
        <visual name="visual"><geometry><box><size>0.05 0.07 0.22</size></box></geometry><material><ambient>0.85 0.2 0.08 1</ambient><diffuse>0.95 0.28 0.1 1</diffuse></material></visual>
        <!-- Visual-only marker; physical contact and box collision are unchanged. -->
        <visual name="aruco_id0">
          <pose>0 0 0.112 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.002</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>pick_place_aruco_4x4_id0.png</albedo_map>
              <metalness>0</metalness><roughness>1</roughness>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>
    <model name="place_zone">
      <static>true</static>
      <pose>0.43 0.18 0.413 0 0 0</pose>
      <link name="marker">
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.006</length></cylinder></geometry><material><ambient>0.1 0.75 0.2 0.6</ambient><diffuse>0.15 0.9 0.25 0.6</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
